{
  "projects": [
    {
      "name": "sandbox-roundtrip",
      "cwd": ".",
      "ssh": {
        "host": "localhost",
        "port": 2222,
        "user": "deploy",
        "identityFile": "test/sandbox/keys/id_test"
      },
      "steps": [
        { "name": "Build payload",  "type": "local",    "run": "mkdir -p .testout && echo merhaba > .testout/payload.txt" },
        { "name": "Upload payload", "type": "transfer", "from": ".testout/payload.txt", "to": "/tmp/payload.txt" },
        { "name": "Verify upload",  "type": "remote",   "run": "test -f /tmp/payload.txt && grep -q merhaba /tmp/payload.txt" },
        { "name": "Cleanup remote", "type": "remote",   "run": "rm -f /tmp/payload.txt" },
        { "name": "Cleanup local",  "type": "local",    "run": "rm -rf .testout" }
      ]
    },

    {
      "name": "sandbox-directory-transfer",
      "cwd": ".",
      "ssh": {
        "host": "localhost",
        "port": 2222,
        "user": "deploy",
        "identityFile": "test/sandbox/keys/id_test"
      },
      "steps": [
        { "name": "Build dir",     "type": "local",    "run": "mkdir -p .testdir/sub && echo a > .testdir/a.txt && echo b > .testdir/sub/b.txt" },
        { "name": "Upload dir",    "type": "transfer", "from": ".testdir",        "to": "/tmp/" },
        { "name": "Verify files",  "type": "remote",   "run": "test -f /tmp/.testdir/a.txt && test -f /tmp/.testdir/sub/b.txt" },
        { "name": "Cleanup remote","type": "remote",   "run": "rm -rf /tmp/.testdir" },
        { "name": "Cleanup local", "type": "local",    "run": "rm -rf .testdir" }
      ]
    },

    {
      "name": "sandbox-sudo",
      "cwd": ".",
      "ssh": {
        "host": "localhost",
        "port": 2222,
        "user": "deploy",
        "identityFile": "test/sandbox/keys/id_test"
      },
      "steps": [
        { "name": "Sudo write",    "type": "remote", "run": "echo roadie-test | sudo tee /var/lib/probe.txt > /dev/null" },
        { "name": "Sudo verify",   "type": "remote", "run": "sudo test -f /var/lib/probe.txt" },
        { "name": "Sudo cleanup",  "type": "remote", "run": "sudo rm -f /var/lib/probe.txt" }
      ]
    }
  ]
}
